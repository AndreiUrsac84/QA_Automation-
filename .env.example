# Mediu țintă (implicit: producție)
BASE_URL=https://dauron-trust.com
# Dacă BASE_URL nu răspunde (ex. fără internet), testele rulează pe fallback
BASE_URL_FALLBACK=http://localhost:8080

# false = browserul se vede; true = fără fereastră (în CI e mereu headless)
HEADLESS=false

# Încetinește fiecare acțiune, în ms, ca să poți urmări testul (0 = dezactivat)
SLOW_MO=0

# Cât stă testul pe fiecare pagină după navigare, în ms (0 = fără pauză)
PAGE_PAUSE_MS=1000

# Turul prin pagini (npm run test:tour): secunde pe pagină, număr de rulări, minute între porniri
TOUR_PAGE_SECONDS=5
TOUR_ARTICLE_SECONDS=12
TOUR_RUNS=20
TOUR_INTERVAL_MIN=10
# Motoarele din tur, pe rând (chromium,firefox,webkit)
TOUR_BROWSERS=chromium,firefox,webkit

# Câte teste rulează în paralel (1 = pe rând, un singur browser deschis)
WORKERS=1

# Doar la cerere explicită: trimite formularul de contact REAL
# CONTACT_LIVE_SUBMIT=1
